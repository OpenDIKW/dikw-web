DIKW_AGENT_PROVIDER=minimax
DIKW_AGENT_API=anthropic-messages
DIKW_AGENT_API_KEY=<copy MiniMax key from ../dikw-core/.env ANTHROPIC_API_KEY>
DIKW_AGENT_BASE_URL=https://api.minimaxi.com/anthropic
DIKW_AGENT_MODEL=MiniMax-M3

# Optional web tools. Each key enables exactly one sidecar tool; leave unset to disable.
# DIKW_AGENT_TAVILY_API_KEY=<Tavily API key>           # active backend for web_search
# DIKW_AGENT_JINA_API_KEY=<Jina Reader API key>        # backs web_fetch
# DIKW_AGENT_BRAVE_API_KEY=<Brave Search subscription token>  # retained in WebToolClient.search but not currently exposed to the agent

# Optional context-window compaction (on by default). Threshold = round(window * ratio).
# DIKW_AGENT_COMPACTION_ENABLED=true      # set false/0 to disable compaction entirely
# DIKW_AGENT_CONTEXT_WINDOW=1048576       # model context window in tokens (MiniMax-M3 = 1M)
# DIKW_AGENT_COMPACTION_RATIO=0.5         # trigger fraction of the window
# DIKW_AGENT_COMPACTION_RETENTION=8       # min recent raw events kept verbatim

# Optional browser-side conversion (Import page). Enables PDF / Office → markdown via mineru.net.
# DIKW_WEB_MINERU_API_KEY=<mineru.net API key>   # unset → ImportPage accepts only .md / .pdf

# Optional OpenTelemetry trace export (opt-in, standard OTEL_* env). Unset → agent spans
# stay in the in-memory #trace view only and behavior is unchanged. Set the OTLP endpoint to
# also export spans (tagged service.name=dikw-web) to any OTLP backend — Collector, Jaeger,
# Grafana Tempo, Honeycomb, Datadog (the last two also need OTEL_EXPORTER_OTLP_HEADERS).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OTLP/HTTP; or OTEL_EXPORTER_OTLP_TRACES_ENDPOINT
# OTEL_SERVICE_NAME=dikw-web                           # service.name on exported telemetry (default: dikw-web)
# OTEL_TRACES_SAMPLER=parentbased_always_on            # or parentbased_traceidratio + OTEL_TRACES_SAMPLER_ARG=0.1

# Optional Base-reader translation (AI 翻译). Enables on-demand bilingual reading of
# English articles via an LLM. The translator reuses the chat agent's MiniMax
# credentials above (DIKW_AGENT_API_KEY / _BASE_URL / _MODEL) — set those and the
# feature is on; leave DIKW_AGENT_API_KEY unset → reader hides the AI 翻译 entry (503).
# DIKW_WEB_TRANSLATOR_MAX_TOKENS=64000               # output cap per translation; raise for very long docs

