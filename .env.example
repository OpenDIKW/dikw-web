DIKW_AGENT_PROVIDER=minimax
DIKW_AGENT_API=anthropic-messages
DIKW_AGENT_API_KEY=<copy MiniMax key from ../dikw-core/.env ANTHROPIC_API_KEY>
DIKW_AGENT_BASE_URL=https://api.minimaxi.com/anthropic
DIKW_AGENT_MODEL=MiniMax-M3

# Optional web tools. Each key enables exactly one sidecar tool; leave unset to disable.
# DIKW_AGENT_TAVILY_API_KEY=<Tavily API key>           # active backend for web_search
# DIKW_AGENT_JINA_API_KEY=<Jina Reader API key>        # backs web_fetch
# DIKW_AGENT_BRAVE_API_KEY=<Brave Search subscription token>  # retained in WebToolClient.search but not currently exposed to the agent

# Optional context-window compaction (on by default). Threshold = round(window * ratio).
# DIKW_AGENT_COMPACTION_ENABLED=true      # set false/0 to disable compaction entirely
# DIKW_AGENT_CONTEXT_WINDOW=1048576       # model context window in tokens (MiniMax-M3 = 1M)
# DIKW_AGENT_COMPACTION_RATIO=0.5         # trigger fraction of the window
# DIKW_AGENT_COMPACTION_RETENTION=8       # min recent raw events kept verbatim

# Optional browser-side conversion (Import page). Enables PDF / Office → markdown via mineru.net.
# DIKW_WEB_MINERU_API_KEY=<mineru.net API key>   # unset → ImportPage accepts only .md / .pdf

# Optional OpenTelemetry export — traces + metrics + logs (opt-in, standard OTEL_* env).
# Unset → agent spans stay in the in-memory #trace view, logs print to stdout, metrics
# are no-ops, and behavior is unchanged. Set the OTLP endpoint to export all three signals
# (tagged service.name=dikw-web) to any OTLP backend — the local demo stack
# (docker-compose.observability.yml), Jaeger/Tempo, Grafana Cloud, Honeycomb, Datadog.
# Full reference + the demo stack: docs/observability.md.
#
# NOTE: unlike the DIKW_* keys above, OTEL_* are NOT read from this .env.local file —
# ADK's exporters read process.env directly. Export them into the environment instead:
# inline (`OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 npm.cmd start`), a shell
# `export`, or the container's `environment:` block.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OTLP/HTTP base; auto-appends /v1/traces|metrics|logs
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces   # per-signal override; FULL url incl. path (also _METRICS_ …/v1/metrics, _LOGS_ …/v1/logs)
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>    # auth for Grafana Cloud / Honeycomb / Datadog
# OTEL_SERVICE_NAME=dikw-web                           # service.name on exported telemetry (default: dikw-web)
# OTEL_TRACES_SAMPLER=parentbased_always_on            # or parentbased_traceidratio + OTEL_TRACES_SAMPLER_ARG=0.1
# Browser RUM (frontend traces) is enabled separately, per deployment, via a `telemetry`
# block in public/config.json (NOT env) — see public/config.example.json + docs/observability.md.

# Optional Base-reader translation (AI 翻译). Enables on-demand bilingual reading of
# English articles via an LLM. The translator reuses the chat agent's MiniMax
# credentials above (DIKW_AGENT_API_KEY / _BASE_URL / _MODEL) — set those and the
# feature is on; leave DIKW_AGENT_API_KEY unset → reader hides the AI 翻译 entry (503).
# DIKW_WEB_TRANSLATOR_MAX_TOKENS=64000               # output cap per translation; raise for very long docs

# Optional OIDC auth mode (issue #200) — standalone server only (`npm start` / Docker);
# `npm run dev` always runs with auth off. Turns dikw-web into a Backend-for-Frontend:
# sign-in through an OIDC provider, the core token stays server-side (/v1 is proxied),
# per-user agent sessions, viewer/editor roles. Missing required vars fail fast.
# Full reference + reverse-proxy recipe: docs/deployment.md; design: docs/adr/0006-oidc-auth-bff.md.
# DIKW_WEB_AUTH_MODE=oidc
# DIKW_WEB_PUBLIC_URL=https://kb.example.com         # browser-facing origin; callback = {PUBLIC_URL}/web/auth/callback
# DIKW_WEB_OIDC_ISSUER=https://iam.example.com
# DIKW_WEB_OIDC_INTERNAL_URL=http://idp:8000         # optional private origin for discovery/token/JWKS
# DIKW_WEB_OIDC_CLIENT_ID=<client id>
# DIKW_WEB_OIDC_CLIENT_SECRET=<client secret>
# DIKW_WEB_OIDC_SCOPES=openid profile email
# DIKW_WEB_OIDC_ROLES_CLAIM=roles                    # e.g. groups, realm_access.roles, roles[].name (Casdoor)
# DIKW_WEB_OIDC_ROLES_OWNER=my-org                   # optional: keep only role objects of this owner (Casdoor org)
# DIKW_WEB_ROLE_VIEWER=kb_viewer                     # comma-separated; at least one of VIEWER / EDITOR
# DIKW_WEB_ROLE_EDITOR=kb_editor
# DIKW_WEB_SESSION_SECRET=<at least 32 random chars, e.g. openssl rand -base64 48>       # rotating it signs everyone out
# DIKW_WEB_SESSION_TTL_SECONDS=28800                 # absolute session lifetime (default 8h)
# DIKW_CORE_URL=http://dikw-core:8765                # core as the server sees it
# DIKW_SERVER_TOKEN=<dikw-core bearer token>
# DIKW_WEB_AUTH_LEGACY_SESSIONS_OWNER=<oidc sub>     # optional: who inherits the pre-auth "demo" chats

