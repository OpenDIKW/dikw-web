{
  "name": "@opendikw/web-ui",
  "version": "0.1.5",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./reader": {
      "types": "./dist/reader/index.d.ts",
      "import": "./dist/reader/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./tokens.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles/tokens.css"
    },
    "./controls.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles/controls.css"
    },
    "./reader.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles/reader.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenDIKW/dikw-web.git",
    "directory": "packages/web-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opendikw/web-client": "0.1.5",
    "lucide-react": "1.49.0",
    "markdown-it": "15.0.2",
    "katex": "0.18.9",
    "mermaid": "11.17.2",
    "echarts": "6.1.0"
  }
}
