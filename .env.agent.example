DIKW_AGENT_PROVIDER=minimax
DIKW_AGENT_API=anthropic-messages
DIKW_AGENT_API_KEY=<copy MiniMax key from ../dikw-core/.env ANTHROPIC_API_KEY>
DIKW_AGENT_BASE_URL=https://api.minimaxi.com/anthropic
DIKW_AGENT_MODEL=MiniMax-M3

# Optional web tools. Each key enables exactly one sidecar tool; leave unset to disable.
# DIKW_AGENT_TAVILY_API_KEY=<Tavily API key>           # active backend for web_search
# DIKW_AGENT_JINA_API_KEY=<Jina Reader API key>        # backs web_fetch
# DIKW_AGENT_BRAVE_API_KEY=<Brave Search subscription token>  # retained in WebToolClient.search but not currently exposed to the agent

# Optional context-window compaction (on by default). Threshold = round(window * ratio).
# DIKW_AGENT_COMPACTION_ENABLED=true      # set false/0 to disable compaction entirely
# DIKW_AGENT_CONTEXT_WINDOW=1048576       # model context window in tokens (MiniMax-M3 = 1M)
# DIKW_AGENT_COMPACTION_RATIO=0.5         # trigger fraction of the window
# DIKW_AGENT_COMPACTION_RETENTION=8       # min recent raw events kept verbatim

