# Provider keys for the LIVE dikw-core that the integration harness boots
# (docker-compose.live-core.yml). Copy to .env.core and fill in — .env.core is
# git-ignored. These are dikw-core's keys (named by the harness dikw.yml), NOT
# dikw-web's agent keys (those stay in .env.local). See
# docs/integration-verification.md.

# Required — MiniMax LLM (Anthropic-compatible) for ingest/synth/lint.
MINIMAX_API_KEY=

# Required — Gitee AI embeddings (Qwen3-Embedding-0.6B, OpenAI-compatible).
GITEE_API_KEY=

# Optional — spare provider; not used by the default harness dikw.yml.
DEEPSEEK_API_KEY=
