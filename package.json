{
  "name": "dikw-web",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4321 --strictPort",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/agent/standalone.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist-server/standalone.mjs --legal-comments=none --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node dist-server/standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.75.4",
    "@earendil-works/pi-ai": "^0.78.0",
    "d3-force": "^3.0.0",
    "echarts": "^6.1.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.15.0",
    "pixi.js": "^8.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.0.16"
  }
}
