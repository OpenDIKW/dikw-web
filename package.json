{
  "name": "dikw-web",
  "version": "0.11.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:packages && vite --host 127.0.0.1 --port 4321 --strictPort",
    "build": "npm run build:packages && tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/agent/standalone.ts --bundle --packages=external --platform=node --target=node24 --format=esm --outfile=dist-server/standalone.mjs --legal-comments=none --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node dist-server/standalone.mjs",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:packages && vitest run",
    "test:watch": "npm run build:packages && vitest",
    "test:coverage": "npm run build:packages && vitest run --coverage",
    "test:e2e": "npm run build:packages && playwright test",
    "smoke:core": "node scripts/smoke-core.mjs",
    "live:up": "node scripts/live-core/up.mjs",
    "live:down": "node scripts/live-core/down.mjs",
    "live:seed": "npm run build:packages && tsx scripts/seed-core.mts",
    "live:smoke": "node scripts/live-core/smoke.mjs",
    "live:verify": "npm run build:packages && node scripts/live-core/run.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:gate": "node scripts/check-gate-integrity.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e && npm run verify:packages",
    "build:packages": "node scripts/build-shared-packages.mjs",
    "pack:shared": "node scripts/pack-shared-packages.mjs",
    "verify:packages": "npm run pack:shared && node scripts/verify-package-consumers.mjs",
    "publish:shared": "node scripts/publish-shared-packages.mjs",
    "verify:registry": "node scripts/verify-registry-packages.mjs",
    "version:shared": "node scripts/set-shared-version.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/adk": "^2.1.0",
    "@google/genai": "^2.24.0",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/sqlite": "^7.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-document-load": "^0.67.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "d3-force": "^3.0.0",
    "echarts": "^6.1.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.49.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^11.17.2",
    "openid-client": "^6.8.8",
    "pixi.js": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.3.0",
    "undici": "^8.10.0",
    "@opendikw/web-client": "0.1.0",
    "@opendikw/web-ui": "0.1.0",
    "@opendikw/web-server": "0.1.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "form-data": "^2.5.6",
    "hono": "^4.12.25",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "dompurify": "^3.4.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
