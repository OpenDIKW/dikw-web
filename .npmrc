# better-sqlite3 (via @mikro-orm/sqlite) ships N-API prebuilts and loads them first,
# but `npm ci` reads lockfile metadata that drops its `gypfile: false`, so npm 11 runs
# an implicit `node-gyp rebuild` that fails without python + a C++ toolchain. No
# dependency here needs its install script; scripts/install-scripts.test.mjs keeps
# that reviewed list honest.
ignore-scripts=true
